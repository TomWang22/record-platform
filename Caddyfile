# -----------------------------------------------------------------------------
# PORTING: When reusing this substrate in another project, change:
#   1. Hostname: record-platform.test (vhost below; scripts use --resolve record-platform.test:443:<LB_IP>).
#   2. Service targets: replace "record-platform" in *.record-platform.svc.cluster.local with your app namespace.
#   3. Paths: adjust /api/, /auctions/, /ai/, /privacy, /terms if your routes differ.
#   Keep: grace_period, servers.protocols (h1 h2 h3), transport h2c, TLS paths, log format.
# -----------------------------------------------------------------------------
{
	admin 0.0.0.0:2019
	# Graceful shutdown: drain QUIC/TLS before process exit during rotation (avoids mid-flight connection death).
	# 15s/10s gives QUIC sessions time to close cleanly; matches production CA+leaf rotation runbook.
	grace_period 15s
	shutdown_delay 10s
	# HTTP/3 (QUIC) is enabled automatically when using port 443 with TLS
	log {
		output stdout
		format console
		level INFO
	}
	# Enable HTTP/2 and HTTP/3. Longer timeouts reduce connection churn and QUIC idle shutdown under rotation load.
	# idle 2m: avoid Caddy closing connections before k6; read_body/write 2m avoid mid-request timeouts.
	# Note: max_concurrent_streams for H2 is not exposed in Caddyfile; connection reuse disabled in k6 rotation instead.
	servers {
		protocols h1 h2 h3
		timeouts {
			idle 2m
			read_body 2m
			write 2m
		}
		# Full-duplex helps HTTP/3 request/response overlap under load
		enable_full_duplex
	}
}

# Primary vhost - HTTP/3, Web App, REST API, and gRPC (via Envoy)
# gRPC: Caddy terminates TLS and proxies to Envoy (h2c). Clients use Caddy LB IP with -authority record-platform.test.
# QUIC: clients must use SNI = record-platform.test (e.g. --resolve record-platform.test:443:<ip>). See docs/QUIC_INVARIANT_CHECKLIST.md.
#
# H2 vs H3 routing debug:
#   curl --http2 -v --resolve record-platform.test:443:<LB_IP> --cacert certs/dev-chain.pem https://record-platform.test/api/resell/...
#   curl --http3 -v --resolve record-platform.test:443:<LB_IP> --cacert certs/dev-chain.pem https://record-platform.test/api/resell/...
https://record-platform.test {
	tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key {
		protocols tls1.2 tls1.3
		client_auth {
			mode verify_if_given
			trust_pool file /etc/caddy/mtls-test/mtls-test-ca.pem
		}
	}

	# REST API paths (contract): /api/* /auth/* /shopping/* /messaging/* /community/*
	# /media/* /trust/* /notification/* /analytics/* /insights/* /ai/* /python-ai/*
	# /auctions/* /auction-monitor/*
	header {
		# alt-svc advertisement for HTTP/3 (QUIC on :443)
		Alt-Svc `h3=":443"; ma=86400`
	}

	# Request access log: host, uri, proto for H2 vs H3 comparison (kubectl logs deploy/caddy-h3 -n ingress-nginx)
	log request_access {
		output stdout
		format json
		level INFO
	}

	# Privacy and Terms pages - route directly to auth-service (BEFORE catch-all)
	@privacy {
		path /privacy
	}
	handle @privacy {
		reverse_proxy http://auth-service.record-platform.svc.cluster.local:4001 {
			header_up Host {http.request.host}
		}
	}

	@terms {
		path /terms
	}
	handle @terms {
		reverse_proxy http://auth-service.record-platform.svc.cluster.local:4001 {
			header_up Host {http.request.host}
		}
	}

	# Health check endpoints
	handle_path /_caddy/healthz {
		respond "ok" 200
	}

	# Edge health (no client cert) — api-gateway /healthz
	handle /healthz {
		reverse_proxy http://api-gateway.record-platform.svc.cluster.local:4000 {
			header_up Host {http.request.host}
			transport http {
				versions h1
			}
		}
	}

	# Dev mTLS edge probe — mtls-test CA (secret rp-mtls-test-ca → /etc/caddy/mtls-test/)
	map {http.request.tls.client.subject} {mtls_client_tier} {
		~rp-mtls-test-client ok
		default deny
	}
	handle /mtls-healthz {
		@mtls_ok expression {mtls_client_tier} == "ok"
		respond @mtls_ok "ok" 200
		respond "Forbidden" 403
	}

	# Auction Monitor & Python AI health ( /auctions/healthz, /ai/healthz ) -> api-gateway
	# These are NOT under /api/ so we route them explicitly; api-gateway serves /auctions/healthz and /ai/healthz
	handle /auctions/healthz {
		reverse_proxy http://api-gateway.record-platform.svc.cluster.local:4000 {
			header_up Host {http.request.host}
			transport http {
				versions h1
			}
		}
	}
	handle /ai/healthz {
		reverse_proxy http://api-gateway.record-platform.svc.cluster.local:4000 {
			header_up Host {http.request.host}
			transport http {
				versions h1
			}
		}
	}

	# gRPC: route to Envoy via h2c only (Content-Type: application/grpc).
	# TODO: remove X-OCH-Edge-Proto once all RP interceptors use X-RP-Edge-Proto only.
	@grpc {
		header Content-Type application/grpc*
	}
	handle @grpc {
		reverse_proxy envoy-test.envoy-test.svc.cluster.local:10000 {
			header_up Host {http.request.host}
			header_up X-RP-Edge-Proto {http.request.proto}
			header_up X-OCH-Edge-Proto {http.request.proto}
			transport http {
				versions h2c
			}
		}
	}

	# Explicit /api/resell — match /api/resell, /api/resell/, /api/resell/:id so H2 and H3 route identically (path /api/resell/* does not match /api/resell without trailing segment).
	# log_append (early) for H2 vs H3 debug: kubectl logs deploy/caddy-h3 -n ingress-nginx | grep request_
	@resell path_regexp ^/api/resell(/.*)?$
	handle @resell {
		log_append <request_host {http.request.host}
		log_append <request_uri {http.request.uri}
		log_append <request_proto {http.request.proto}
		reverse_proxy http://api-gateway.record-platform.svc.cluster.local:4000 {
			header_up Host {http.request.host}
			transport http {
				versions h1
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}

	# Next.js BFF routes (must hit webapp, not api-gateway)
	@webapp_bff {
		path /api/webapp-version
		path /api/messages/*
	}
	handle @webapp_bff {
		reverse_proxy http://webapp.record-platform.svc.cluster.local:3001 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			transport http {
				versions h1
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}

	# Observability UIs (subpath on edge TLS — before webapp catch-all)
	@obs_grafana_root path /grafana
	handle @obs_grafana_root {
		redir /grafana/ 308
	}
	handle_path /grafana/* {
		reverse_proxy grafana.observability.svc.cluster.local:3000 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@obs_jaeger_root path /jaeger
	handle @obs_jaeger_root {
		redir /jaeger/ 308
	}
	handle_path /jaeger/* {
		reverse_proxy jaeger.observability.svc.cluster.local:16686 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@obs_prometheus_root path /prometheus
	handle @obs_prometheus_root {
		redir /prometheus/ 308
	}
	handle_path /prometheus/* {
		reverse_proxy prometheus.observability.svc.cluster.local:9090 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# REST API requests: route DIRECTLY to api-gateway (NOT through ingress-nginx)
	# Direct routing: Caddy → api-gateway (single-hop, faster, more reliable)
	# CRITICAL: Exclude gRPC paths (service.Service/Method format with dots) - only match REST paths (with slashes)
	@api {
		path_regexp ^/(api/|auth/|shopping/|messaging/|community/|media/|trust/|notification/|analytics/|insights/|ai/|python-ai/|auctions/|auction-monitor/)
		not path_regexp ^/?[a-z_]+\. # Exclude gRPC paths (service.Service format)
	}
	# Browser UI lives under /records/* and /listings/* (Next.js); REST uses /api/records and /api/listings only.
	handle @api {
		reverse_proxy http://api-gateway.record-platform.svc.cluster.local:4000 {
			header_up Host {http.request.host}
			header_up X-RP-Edge-Proto {http.request.proto}
			header_up X-OCH-Edge-Proto {http.request.proto}
			transport http {
				versions h1
				dial_timeout 10s
				response_header_timeout 30s
				expect_continue_timeout 5s
			}
			lb_policy round_robin
			fail_duration 30s
			max_fails 3
		}
	}

	# Catch-all for non-API paths → in-cluster webapp (Next.js on :3001)
	handle {
		reverse_proxy http://webapp.record-platform.svc.cluster.local:3001 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-RP-Edge-Proto {http.request.proto}
			header_up X-OCH-Edge-Proto {http.request.proto}
			transport http {
				versions h1
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}
}

# Catch-all for any hostname on port 443 (including ngrok, probes without SNI, etc.)
:443 {
	tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key {
		protocols tls1.2 tls1.3
	}

	# Health check endpoint for probes without SNI (must be first)
	handle_path /_caddy/healthz {
		respond "ok" 200
	}

	# Privacy and Terms pages - route directly to auth-service (BEFORE catch-all)
	@privacy {
		path /privacy
	}
	handle @privacy {
		reverse_proxy http://auth-service.record-platform.svc.cluster.local:4001 {
			header_up Host {http.request.host}
		}
	}

	@terms {
		path /terms
	}
	handle @terms {
		reverse_proxy http://auth-service.record-platform.svc.cluster.local:4001 {
			header_up Host {http.request.host}
		}
	}

	# Catch-all for non-record-platform.test hosts (ingress-nginx-controller not deployed; use api-gateway)
	# Fixes "no such host" DNS failures that poisoned Caddy readiness
	handle {
		respond "Misdirected Request" 421
	}
}
