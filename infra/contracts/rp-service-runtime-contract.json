{
  "version": 3,
  "description": "Canonical RP runtime ports + TLS/mTLS cert policy. Source: service Dockerfiles + server bind defaults.",
  "services": {
    "api-gateway": {
      "httpPort": 4000,
      "grpcPort": null,
      "healthPath": "/healthz",
      "readyPath": "/readyz",
      "httpEnv": [
        "GATEWAY_PORT"
