      "k8sService": "auth-service",
      "deployment": "auth-service",
      "k8sName": "auth-service",
      "runtimeHealthMode": "both",
      "tlsPolicy": "service-mtls",
      "grpcRequiredForRuntime": true,
      "grpcService": "auth.AuthService",
      "grpcTlsServerName": "auth-service"
    },
