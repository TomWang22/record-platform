    "webapp": {
      "httpPort": 3001,
      "grpcPort": null,
      "healthPath": "/",
      "readyPath": "/",
      "httpEnv": [
        "PORT"
      ],
      "dockerfile": "webapp/Dockerfile",
      "k8sService": "webapp",
      "deployment": "webapp"
    },
    "transport-watchdog": {
      "httpPort": null,
      "grpcPort": null,
      "healthPath": null,
      "readyPath": null,
      "httpEnv": [],
      "dockerfile": "services/transport-watchdog/Dockerfile",
      "k8sService": null,
      "deployment": null,
      "notes": "api-gateway sidecar; no in-cluster gRPC mTLS leaf"
    },
    "ollama": {
      "httpPort": 11434,
      "grpcPort": null,
      "healthPath": "/",
      "readyPath": "/",
      "httpEnv": [],
      "dockerfile": null,
      "k8sService": "ollama",
      "deployment": "ollama",
      "notes": "ML runtime; optional (RP_ENABLE_OLLAMA)"
    },
    "ollama-gateway": {
      "httpPort": 8080,
      "grpcPort": null,
      "healthPath": "/healthz",
      "readyPath": "/healthz",
      "httpEnv": [],
      "dockerfile": null,
      "k8sService": "ollama-gateway",
      "deployment": "ollama-gateway",
      "notes": "Prometheus metrics gateway; optional stack"
    },
    "ollama-worker": {
      "httpPort": null,
      "grpcPort": null,
      "healthPath": null,
      "readyPath": null,
      "httpEnv": [],
      "dockerfile": null,
      "k8sService": "ollama-worker",
      "deployment": "ollama-worker",
      "notes": "Kafka worker for Ollama jobs; optional stack"
    }
  },
  "certPolicy": {
    "edgeHost": "record-platform.test",
    "edgeEku": "serverAuth",
    "k8sSecretModel": "per-service-and-bundle",
    "k8sPerServiceSecretPrefix": "service-tls-",
    "k8sBundleSecret": "rp-service-mtls-bundle",
    "mtlsServices": [
      {
        "serviceName": "api-gateway",
        "certCommonName": "api-gateway",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "auth-service",
        "certCommonName": "auth-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "records-service",
        "certCommonName": "records-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "listings-service",
        "certCommonName": "listings-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "shopping-service",
        "certCommonName": "shopping-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "messaging-service",
        "certCommonName": "messaging-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "media-service",
        "certCommonName": "media-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "trust-service",
        "certCommonName": "trust-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "notification-service",
        "certCommonName": "notification-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "analytics-service",
        "certCommonName": "analytics-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "python-ai-service",
        "certCommonName": "python-ai-service",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      },
      {
        "serviceName": "auction-monitor",
        "certCommonName": "auction-monitor",
        "mtlsRequired": true,
        "eku": "serverAndClient"
      }
    ],
    "nonMtls": [
      {
        "serviceName": "webapp",
        "mtlsRequired": false,
        "reason": "Browser\u2192Caddy edge TLS only; server-side calls via api-gateway (no service mTLS leaf unless direct internal mTLS)"
      },
      {
        "serviceName": "transport-watchdog",
        "mtlsRequired": false,
        "reason": "api-gateway sidecar loopback probe only"
      },
      {
        "serviceName": "ollama",
        "mtlsRequired": false,
        "reason": "in-cluster HTTP to Ollama; no gRPC mTLS leaf"
      },
      {
        "serviceName": "ollama-gateway",
        "mtlsRequired": false,
        "reason": "HTTP metrics gateway; optional ML stack"
      },
      {
        "serviceName": "ollama-worker",
        "mtlsRequired": false,
        "reason": "Kafka consumer worker; optional ML stack"
      }
    ],
    "specialChains": [
      {
        "name": "kafka",
        "reason": "broker/client chain via kafka-ssl-secret (not service mTLS leaves)"
      },
      {
        "name": "envoy-client",
        "eku": "clientAuth",
        "reason": "Envoy gRPC client cert only"
      }
    ]
  }
}
