# eBay API Credentials Secret Template
# 
# IMPORTANT: This is a template file. Do NOT commit actual credentials to git.
# 
# To create the secret:
# 1. Copy this file: cp ebay-credentials.secret.yaml.template ebay-credentials.secret.yaml
# 2. Replace the placeholder values with actual credentials
# 3. Apply: kubectl apply -f ebay-credentials.secret.yaml
# 4. Delete the file: rm ebay-credentials.secret.yaml (never commit this!)
#
# Or create directly:
# kubectl create secret generic ebay-credentials -n record-platform \
#   --from-literal=EBAY_APP_ID='your-app-id' \
#   --from-literal=EBAY_DEV_ID='your-dev-id' \
#   --from-literal=EBAY_CERT_ID='your-cert-id' \
#   --from-literal=EBAY_AUTH_TOKEN='your-auth-token' \
#   --from-literal=EBAY_SANDBOX='false' \
#   --from-literal=DISCOGS_USER_TOKEN='your-discogs-token'

apiVersion: v1
kind: Secret
metadata:
  name: ebay-credentials
  namespace: record-platform
type: Opaque
stringData:
  EBAY_APP_ID: "REPLACE_WITH_ACTUAL_APP_ID"
  EBAY_DEV_ID: "REPLACE_WITH_ACTUAL_DEV_ID"
  EBAY_CERT_ID: "REPLACE_WITH_ACTUAL_CERT_ID"
  EBAY_OAUTH_TOKEN: "REPLACE_WITH_ACTUAL_OAUTH_TOKEN"
  EBAY_SANDBOX: "false"
  DISCOGS_USER_TOKEN: "REPLACE_WITH_ACTUAL_DISCOGS_TOKEN"

