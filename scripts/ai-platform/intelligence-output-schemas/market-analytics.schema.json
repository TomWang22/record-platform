{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://record-platform.local/schemas/ai-platform/market-analytics.schema.json",
  "title": "MarketAnalyticsReport",
  "description": "Structured market report with explicit methodology and sample honesty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analytics_mode",
    "scope",
    "time_range",
    "supply",
    "demand",
    "pricing",
    "liquidity",
    "auction_activity",
    "scarcity_changes",
    "segments",
    "anomalies",
    "opportunities",
    "risks",
    "population_size",
    "sample_size",
    "evidence",
    "confidence",
    "limitations"
  ],
  "properties": {
    "analytics_mode": {
      "type": "string",
      "enum": [
        "release_market_summary",
        "pressing_market_summary",
        "price_distribution",
        "liquidity_report",
        "auction_trend",
        "watchlist_market_report",
        "seller_inventory_report",
        "collection_report",
        "market_temperature_history",
        "comparable_market_movement"
      ]
    },
    "scope": {
      "type": "object"
    },
    "time_range": {
      "$ref": "https://record-platform.local/schemas/ai-platform/shared/time-range.schema.json"
    },
    "population_size": {
      "type": "integer",
      "minimum": 0
    },
    "population_definition": {
      "type": "object"
    },
    "methodology_contract": {
      "type": "object"
    },
    "price_min": { "type": ["number", "null"] },
    "price_max": { "type": ["number", "null"] },
    "price_median": { "type": ["number", "null"] },
    "price_mean": { "type": ["number", "null"] },
    "sold_count": { "type": ["integer", "null"], "minimum": 0 },
    "active_count": { "type": ["integer", "null"], "minimum": 0 },
    "unsold_count": { "type": ["integer", "null"], "minimum": 0 },
    "sell_through_rate": { "type": ["number", "null"] },
    "median_time_to_sale": { "type": ["number", "null"] },
    "liquidity_score": { "type": ["number", "null"] },
    "price_trend": { "type": ["string", "null"] },
    "volume_trend": { "type": ["string", "null"] },
    "excluded_events": {
      "type": "array",
      "items": { "type": "object" }
    },
    "supply": {
      "type": "object"
    },
    "demand": {
      "type": "object"
    },
    "pricing": {
      "type": "object"
    },
    "liquidity": {
      "type": "object"
    },
    "auction_activity": {
      "type": "object"
    },
    "scarcity_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 3,
      "maxLength": 3
    },
    "population": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregation_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://record-platform.local/schemas/ai-platform/shared/evidence-item.schema.json"
      }
    },
    "confidence": {
      "$ref": "https://record-platform.local/schemas/ai-platform/shared/confidence.schema.json"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "https://record-platform.local/schemas/ai-platform/shared/limitation.schema.json"
      }
    },
    "data_freshness": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "methodology": {
      "type": [
        "string",
        "null"
      ]
    },
    "sample_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "abstention_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_scope": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
