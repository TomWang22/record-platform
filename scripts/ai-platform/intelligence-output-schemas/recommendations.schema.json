{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://record-platform.local/schemas/ai-platform/recommendations.schema.json",
  "title": "Recommendations",
  "description": "Ranked recommendations with explainable reason codes. No hidden pay-to-rank.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_mode",
    "recommendation_scope",
    "recommendations",
    "diversity_summary",
    "candidate_summary",
    "excluded_candidates",
    "pay_to_rank",
    "evidence",
    "confidence",
    "limitations"
  ],
  "properties": {
    "recommendation_mode": {
      "type": "string",
      "enum": [
        "similar_release",
        "collection_gap",
        "budget_opportunity",
        "auction_watch",
        "condition_upgrade",
        "seller_restock",
        "sell_hold_watch",
        "portfolio_diversification",
        "market_opportunity"
      ]
    },
    "recommendation_scope": {
      "type": "object"
    },
    "candidate_summary": {
      "type": "object"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "entity_type",
          "rank",
          "score",
          "reason_codes",
          "explanation",
          "supporting_evidence",
          "confidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "release",
              "listing",
              "auction",
              "pressing",
              "market_action"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "explanation": {
            "type": "string"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "$ref": "https://record-platform.local/schemas/ai-platform/shared/evidence-item.schema.json"
            }
          },
          "confidence": {
            "$ref": "https://record-platform.local/schemas/ai-platform/shared/confidence.schema.json"
          },
          "budget_fit": {
            "type": "object"
          },
          "availability": {
            "type": "object"
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "factor_contributions": {
            "type": "object"
          }
        }
      }
    },
    "diversity_summary": {
      "type": "object"
    },
    "excluded_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pay_to_rank": {
      "const": false
    },
    "automatic_send_allowed": {
      "const": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://record-platform.local/schemas/ai-platform/shared/evidence-item.schema.json"
      }
    },
    "confidence": {
      "$ref": "https://record-platform.local/schemas/ai-platform/shared/confidence.schema.json"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "https://record-platform.local/schemas/ai-platform/shared/limitation.schema.json"
      }
    },
    "data_freshness": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "methodology": {
      "type": [
        "string",
        "null"
      ]
    },
    "sample_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "abstention_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_scope": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
