{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://record-platform.local/schemas/ai-platform/shared/limitation.schema.json",
  "title": "Limitation",
  "description": "Explicit limitation or abstention-related caveat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "blocking"
      ]
    }
  }
}
