    },
    "valuation": {
      "STANDARD": { "min_words": 300, "max_words": 700 },
      "DEEP": { "min_words": 650, "max_words": 1300 }
    },
    "auction": {
      "STANDARD": { "min_words": 350, "max_words": 800 },
      "DEEP": { "min_words": 700, "max_words": 1400 }
    },
    "embeddings": {
      "STANDARD": {
        "min_words": 150,
        "max_words": 400,
        "notes": "plus structured lineage fields"
      }
    },
    "semantic_search": {
      "narrative": { "min_words": 120, "max_words": 300 },
      "min_structured_result_cards": 5
    },
    "negotiation": {
      "strategy": { "min_words": 250, "max_words": 650 },
      "draft": { "min_words": 50, "max_words": 140 },
