{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@common/utils": ["../common/dist"],
      "@common/utils/*": ["../common/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../common" }
  ]
}
