{
  "name": "records-service",
  "version": "0.2.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -b && mkdir -p dist/lib && cp src/lib/*.lua dist/lib/",
    "dev": "tsx watch src/server.ts",
    "prestart": "test -f dist/lib/singleflight_cache.lua || (echo '❌ dist/lib/singleflight_cache.lua missing' && exit 1)",
    "start": "node dist/server.js",
    "migrate:custom": "psql \"$POSTGRES_URL\" -f prisma/migrations/INIT.sql",
    "test": "ROLLUP_DISABLE_NATIVE=true vitest run",
    "test:coverage": "ROLLUP_DISABLE_NATIVE=true vitest run --coverage",
    "test:watch": "ROLLUP_DISABLE_NATIVE=true vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@common/utils": "workspace:*",
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.10",
    "@prisma/client": "6.17.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.2.0",
    "http2": "^1.0.0",
    "ioredis": "^5.8.1",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "2.1.9",
    "prisma": "6.17.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
