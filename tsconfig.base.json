{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@common/utils": ["./services/common"],
      "@common/utils/*": ["./services/common/dist/*"]
    }
  }
}
